# Copy to .env (`make env`) and adjust. Secrets do not belong here: they live in ./secrets
# (`make secrets`) and are mounted as Docker secrets.

# Label that identifies this host in logs (Alloy adds it to every stream).
INSTANCE_NAME=observability-lab

# --- Grafana: the only UI meant to be reached from other machines -------------------------
# 127.0.0.1 = local only (SSH tunnel or reverse proxy); 0.0.0.0 = every interface.
GRAFANA_BIND_ADDRESS=127.0.0.1
GRAFANA_HTTP_PORT=3000
GRAFANA_ROOT_URL=http://localhost:3000
GRAFANA_ADMIN_USER=admin
# true when Grafana is served over HTTPS (behind a TLS-terminating proxy).
GRAFANA_COOKIE_SECURE=false

# --- Prometheus and Alertmanager: localhost only by default ------------------------------
PROMETHEUS_BIND_ADDRESS=127.0.0.1
PROMETHEUS_HTTP_PORT=9090
PROMETHEUS_EXTERNAL_URL=http://localhost:9090
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=5GB

ALERTMANAGER_BIND_ADDRESS=127.0.0.1
ALERTMANAGER_HTTP_PORT=9093
ALERTMANAGER_EXTERNAL_URL=http://localhost:9093

# --- Node Exporter (host network, basic auth) ----------------------------------------------
# Listen on every interface by default so the Prometheus container can reach it through
# Docker's host gateway; firewall port 9100 from other machines (the Ansible hardening
# role does), or bind it to the docker0 address, e.g. 172.17.0.1:9100.
NODE_EXPORTER_LISTEN_ADDRESS=0.0.0.0:9100

# --- Tooling -----------------------------------------------------------------------------
# PyPI mirror for `make tools` / `make lock` on networks where pypi.org is unreachable.
# Hashes in tools/requirements.txt still verify every file.
# PIP_INDEX_URL=https://pypi.example.com/simple
# Registry mirror for the Docker daemon inside Molecule's test machines (make test-ansible).
# MOLECULE_DOCKER_MIRROR=https://registry-mirror.example.com
