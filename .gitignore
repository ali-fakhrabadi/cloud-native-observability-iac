# Generated secrets and local overrides never leave the machine.
.env
secrets/*
!secrets/README.md
config/prometheus/targets/*.yml

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
*.auto.tfvars
terraform.tfvars
!**/terraform.tfvars.example
.terraform.tfstate.lock.info
# Lock files are committed for environments (root modules), not reusable modules.
terraform/modules/**/.terraform.lock.hcl
backend.hcl

# Ansible / Molecule
*.retry
.ansible/
.cache/

# Python tooling
__pycache__/
.venv/

# Editors and OS
.idea/
.vscode/
.DS_Store
Thumbs.db
