{
  "uid": "linux-docker-overview",
  "title": "Linux & Docker overview",
  "description": "Host resources from Node Exporter, containers from cAdvisor, logs from Loki.",
  "tags": [
    "linux",
    "docker",
    "node-exporter",
    "cadvisor",
    "loki"
  ],
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "timezone": "browser",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "project",
        "label": "Compose project",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(container_last_seen, container_label_com_docker_compose_project)",
        "query": {
          "query": "label_values(container_last_seen, container_label_com_docker_compose_project)",
          "refId": "project-variable"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "type": "query",
        "name": "device",
        "label": "Interface",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(node_network_receive_bytes_total{device!~\"lo|veth.*|br-.*|docker.*\"}, device)",
        "query": {
          "query": "label_values(node_network_receive_bytes_total{device!~\"lo|veth.*|br-.*|docker.*\"}, device)",
          "refId": "device-variable"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "type": "query",
        "name": "mountpoint",
        "label": "Mount point",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(instance:node_filesystem_avail:ratio{fstype!~\"tmpfs|overlay|squashfs|ramfs|nsfs|fuse.*\"}, mountpoint)",
        "query": {
          "query": "label_values(instance:node_filesystem_avail:ratio{fstype!~\"tmpfs|overlay|squashfs|ramfs|nsfs|fuse.*\"}, mountpoint)",
          "refId": "mountpoint-variable"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Firing alerts",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "red",
        "expr": "ALERTS{alertstate=\"firing\", alertname!=\"Watchdog\"}",
        "step": "60s",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{instance}} {{name}}",
        "useValueForTime": false
      }
    ]
  },
