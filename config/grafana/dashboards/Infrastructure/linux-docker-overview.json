      "title": "Memory against limit",
      "description": "Containers without a memory limit are not shown.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sort_desc(container_memory_working_set_bytes{name!=\"\", container_label_com_docker_compose_project=~\"$project\"} / (container_spec_memory_limit_bytes{name!=\"\", container_label_com_docker_compose_project=~\"$project\"} > 0))",
          "refId": "A",
          "legendFormat": "{{name}}",
          "instant": true,
