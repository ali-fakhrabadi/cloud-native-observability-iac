      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "alertstate": true,
              "Value": true
            },
            "renameByName": {
              "alertname": "Alert",
              "severity": "Severity"
