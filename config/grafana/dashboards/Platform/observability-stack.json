          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (container_label_com_docker_compose_service) (container_memory_working_set_bytes{container_label_com_docker_compose_project=\"observability\"})",
          "refId": "A",
          "legendFormat": "{{container_label_com_docker_compose_service}}"
